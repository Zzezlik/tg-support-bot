# Bot token from @BotFather (required).
# Format: <numbers>:<secret>, e.g. 123456789:AAExampleTokenFromBotFather
BOT_TOKEN=

# Chat or channel ID where the bot sends lead cards (required).
# How to find without running the bot:
#   1. Add the bot to the channel/group (channels require admin rights).
#   2. Post a message or forward a message from the channel to the bot in DM.
#   3. Run `npm run chatid` and copy the ID here.
# For supergroups and channels the ID is negative (-100...).
# For public channels you can use @username instead of numeric ID.
ADMIN_CHAT_ID=

# Forum topic ID inside the group (optional). Find it with `/id` in the topic.
ADMIN_TOPIC_ID=

# Comma-separated Telegram user IDs of administrators.
# They get access to /stats, /leads, /contacts and status buttons.
# Your user ID is shown by `/id`.
ADMIN_IDS=

# JSON storage file for leads. In Docker: /app/data/leads.json.
DATA_FILE=data/leads.json

# JSON storage file for settings (user languages, contacts, services).
# In Docker: /app/data/settings.json.
SETTINGS_FILE=data/settings.json

# Initial texts for "Contacts" and "Services" sections (optional).
# Applied only on first run when settings file doesn't exist.
# After that, edit via /contacts command. Use \n for line breaks.
# CONTACTS_UK=Telegram: @username\nEmail: hello@example.com\nHours: Mon–Fri, 10:00–19:00
# CONTACTS_EN=Telegram: @username\nEmail: hello@example.com\nHours: Mon–Fri, 10:00–19:00
# SERVICES_UK=• Consultation\n• Development\n• Support
# SERVICES_EN=• Consultation\n• Development\n• Support

# Timezone used by the bot (card timestamps, logs).
TZ=UTC

# Log level: error | warn | info | debug
LOG_LEVEL=info